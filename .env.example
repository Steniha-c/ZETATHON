# ==============================================================================
# ZETATHON - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-zetathon-jwt-key-change-in-production
OTP_SALT=zetathon-otp-cryptographic-salt-change-in-production

# Security & Admin Configuration
# In production (NODE_ENV=production), public demo logins are automatically disabled.
ENABLE_DEV_DEMO_ACCOUNTS=true
AUTO_APPROVE_REGISTRATIONS=false
INITIAL_ADMIN_EMAIL=admin@zetathon.org
INITIAL_ADMIN_PASSWORD=

# Email Delivery Configuration (Choose Resend or standard SMTP)
# Option A: Resend API (Recommended)
RESEND_API_KEY=
EMAIL_FROM=ZETATHON <noreply@zetathon.org>

# Option B: Standard SMTP / Nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Supabase PostgreSQL & Auth Credentials
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Frontend Vite Configuration (client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
VITE_ENABLE_DEMO_LOGINS=true
